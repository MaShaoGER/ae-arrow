    function find(layer){var es=layer.property('ADBE Effect Parade'),i;for(i=1;i<=es.numProperties;i++){if(es.property(i).matchName===match){return es.property(i);}}return null;}
    function install(layer){
        var c=layer.containingComp,selected=c.selectedLayers,i,file=new File(Folder.temp.fsName+'/AE-Arrow-0401.ffx'),before=layer.property('ADBE Effect Parade').numProperties;
        try{
            file.encoding='BINARY';if(!file.open('w')){throw new Error('无法写入箭头控件预设：'+file.error);}
            try{if(!file.write(binary)){throw new Error('无法写入箭头控件预设。');}}finally{file.close();}
            for(i=1;i<=c.numLayers;i++){c.layer(i).selected=false;}layer.selected=true;
            layer.applyPreset(file);
            var e=find(layer);if(!e){throw new Error('当前 AE 无法载入箭头伪效果控件。');}e.name=title;
            return e;
        }catch(error){
            var es=layer.property('ADBE Effect Parade');while(es.numProperties>before){es.property(es.numProperties).remove();}throw error;
        }finally{
            for(i=1;i<=c.numLayers;i++){c.layer(i).selected=false;}for(i=0;i<selected.length;i++){try{selected[i].selected=true;}catch(ignore){}}
        }
    }
    function property(layer,key){var e=find(layer);return e&&indices.hasOwnProperty(key)?e.property(indices[key]):null;}
    function value(layer,key){if(/Depth$/.test(key)){var end=key.substr(0,key.length-5),angle=Math.max(5,Math.min(170,value(layer,end+'Angle')));return Math.max(.5,value(layer,end+'Width')/(2*Math.tan(angle*Math.PI/360)));}var p=property(layer,key);return /Type$/.test(key)?p.value-1:p.value;}
    function encodedValue(key,value){return /Type$/.test(key)?value+1:value;}
    function ref(key,owner){if(/Depth$/.test(key)){var end=key.substr(0,key.length-5);return '(Math.max(.5,'+ref(end+'Width',owner)+'/(2*Math.tan(Math.max(5,Math.min(170,'+ref(end+'Angle',owner)+'))*Math.PI/360))))';}var r=(owner?owner+'.':'')+'effect('+A.Codec.stringify(title)+')('+indices[key]+')';return /Type$/.test(key)?'('+r+'-1)':r;}
    A.LegacyPseudo={find:find,install:install,property:property,value:value,encodedValue:encodedValue,ref:ref,indices:indices,matchName:match,title:title};
}(Arrow));
