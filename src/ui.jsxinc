        var importButton = presetActions.add("button", undefined, "打开预设…");
        var presetNote = presetsTab.add("statictext", undefined, "载入预设只改变面板参数；点击“更新选中”应用到现有箭头。\n可读取选中箭头，再创建新箭头以复制其样式。\n保存 / 打开预设可能需要开启 AE 的脚本文件访问权限。", { multiline: true });
