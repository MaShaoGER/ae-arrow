                if (!/^-?(?:\d+(?:\.\d*)?|\.\d+)$/.test(text) || !isFinite(value) || value < min || value > max) {
                    controls[key].load(get(state, key)); message(label + "请输入 " + min + "–" + max + " 之间的数字。"); return;
                }
