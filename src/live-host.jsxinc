            return readLayer(layer,c);
        }catch(error){if(!committed){for(i=applied.length-1;i>=0;i--){try{transform(applied[i].h,'ADBE Position').expression='';applied[i].h.setParentWithJump(applied[i].frame);}catch(ignoreRollback){}}}throw error;}
