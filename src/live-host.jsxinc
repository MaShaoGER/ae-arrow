        catch(error){var n,footage=[];for(n=created.length-1;n>=0;n--){try{if(created[n].source){footage.push(created[n].source);}created[n].locked=false;created[n].remove();}catch(ignored){}}for(n=footage.length-1;n>=0;n--){try{if(!footage[n].usedIn.length){footage[n].remove();}}catch(ignoredFootage){}}while(layer.property("ADBE Effect Parade").numProperties>oldEffects){layer.property("ADBE Effect Parade").property(layer.property("ADBE Effect Parade").numProperties).remove();}try{wire(layer,oldDescriptor,true);}catch(ignoredWire){}throw error;}
        finally{app.endUndoGroup();}
    }
    function upgradeSliders(target){
        var layer=resolve(target),data=info(layer);if(nativeControls(layer)){return readLayer(layer,layer.containingComp);}if(layer.locked){fail("箭头图层已锁定。");}
        var keys=["width","startLength","startDepth","endLength","endDepth"],p=readLayer(layer,layer.containingComp).params,i,h,prop;
        for(i=0;i<keys.length;i++){h=controller(layer,keys[i]);prop=transform(h,keys[i]==="width"?"ADBE Position_1":"ADBE Position_0");if(prop.numKeys||prop.expression!==""||effect(layer,keys[i]).numKeys){fail("旧版样式点已有动画或表达式，保留原控制；请新建箭头使用直接滑块。");}}
        if(effect(layer,"startAngle").numKeys||effect(layer,"endAngle").numKeys){fail("旧版角度已有动画，保留原控制；请新建箭头使用直接滑块。");}
        if(effect(layer,"startWidth").numKeys||effect(layer,"endWidth").numKeys||effect(layer,"startWidth").expression!==""||effect(layer,"endWidth").expression!==""){fail("旧版头部高度已有动画，保留原控制；请新建箭头使用直接滑块。");}
        app.beginUndoGroup("AE Arrow Live — 转为滑块");
        try{for(i=0;i<keys.length;i++){prop=effect(layer,keys[i]);prop.expression="";prop.setValue(p[keys[i]]);h=controller(layer,keys[i]);h.enabled=false;h.shy=true;h.selected=false;}
            prop=effect(layer,"startAngle");prop.expression="";prop.setValue(p.startAngle);prop=effect(layer,"endAngle");prop.expression="";prop.setValue(p.endAngle);
            installSliders(layer);data.controls="sliders";data.version=3;saveInfo(layer,data);return readLayer(layer,layer.containingComp);
        }finally{app.endUndoGroup();}
    }
    function upgradePseudo(target){
        var layer=resolve(target),data=info(layer),key,prop,p,e;
        if(data.controls==='pseudo'){return readLayer(layer,layer.containingComp);}if(layer.locked){fail('箭头图层已锁定。');}
        if(data.controls!=='sliders'){fail('请先将旧版样式点转为滑块，再转换伪效果。');}
        for(key in names){if(names.hasOwnProperty(key)){
            prop=effect(layer,key);
            var allowed=key==='startDepth'||key==='endDepth',end=key.substr(0,key.length-5),oldDepth="var a=Math.max(5,Math.min(170,effect('AA "+(end==='start'?'Start':'End')+" Angle')(1)));Math.max(.5,effect('AA "+(end==='start'?'Start':'End')+" Width')(1)/(2*Math.tan(a*Math.PI/360)));";
            if(prop.numKeys||(prop.expression!==''&&!(allowed&&(prop.expression===depthExpression(layer,end)||prop.expression===oldDepth)))){fail('样式参数已有动画或自定义表达式，保留原控件；请新建箭头使用伪效果。');}
