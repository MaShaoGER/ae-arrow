    function selectOnly(c,layers){var i,props=c.selectedProperties;for(i=0;i<props.length;i++){props[i].selected=false;}for(i=1;i<=c.numLayers;i++){c.layer(i).selected=false;}for(i=0;i<layers.length;i++){layers[i].selected=true;}}
    function sourceLabel(target){var layer=resolve(target),p=sourceProperty(layer),parts=[p.name],g=p.parentProperty;while(g&&g.parentProperty){parts.unshift(g.name);g=g.parentProperty;}parts.unshift(layer.containingComp.layer(effect(layer,'AA Source').value).name);return parts.join(' → ');}
    function editSource(target){var layer=resolve(target),c=layer.containingComp,p=sourceProperty(layer),source=c.layer(effect(layer,'AA Source').value);c.openInViewer();selectOnly(c,[source]);p.selected=true;
