    function selectArrow(target){var layer=resolve(target);selectOnly(layer.containingComp,[layer]);return layer;}
    function showPoints(target,index){
        var layer=resolve(target),data=info(layer),count=Math.min(sourceProperty(layer).value.vertices.length,data.descriptor.pointCount||0),layers=[],i,h;
        if(!count){fail("请先点击“生成 / 补齐路径点”。");}
        for(i=0;i<count;i++){if(index!==undefined&&index!==i){continue;}h=pointController(layer,i);if(h){layers.push(h);}}
        if(!layers.length){fail("路径点空对象已删除，请点击“生成 / 补齐路径点”修复。");}selectOnly(layer.containingComp,layers);
    }
    function syncPoints(target){
        var layer=resolve(target),data=info(layer),oldDescriptor=A.Codec.parse(A.Codec.stringify(data.descriptor)),source=layer.containingComp.layer(effect(layer,"AA Source").value),p=sourceProperty(layer),created=[],oldEffects=layer.property("ADBE Effect Parade").numProperties;
