        if(nativeSliders&&(key==="startDepth"||key==="endDepth")){return setAngle(target,key.substr(0,key.length-5),2*Math.atan(effect(layer,key.substr(0,key.length-5)+"Width").value/(2*Math.max(.5,value)))*180/Math.PI);}
