    function setAngle(target,end,angle){var layer=resolve(target);if(end!=="start"&&end!=="end"){fail("未知端点。");}if(typeof angle!=="number"||!isFinite(angle)){fail("请输入有效角度。");}angle=Math.max(5,Math.min(170,angle));if(nativeControls(layer)){set(target,end+"Angle",angle);}else{var height=effect(layer,end+"Width").value;set(target,end+"Depth",height/(2*Math.tan(angle*Math.PI/360)));}}
    function showHandles(target){var layer=resolve(target),c=active(),keys=["width"],i;
        if(nativeControls(layer)){return showPoints(target);}
