        if(effect(layer,"endType").value>0){keys.push("endLength");keys.push("endDepth");}
        for(i=1;i<=c.numLayers;i++){c.layer(i).selected=false;}for(i=0;i<keys.length;i++){controller(layer,keys[i]).selected=true;}
    }
    function selectHandle(target,key){var layer=resolve(target),c=active(),i,h=controller(layer,key);for(i=1;i<=c.numLayers;i++){c.layer(i).selected=false;}h.selected=true;}
    function sourceProperty(layer){var source=layer.containingComp.layer(effect(layer,"AA Source").value),d=info(layer).descriptor,i;
        var p;if(d.kind==="mask"){p=source.property("ADBE Mask Parade").property(d.label).property("ADBE Mask Shape");}
        else{var wrappers=d.path.match(/\.content\(("(?:[^"\\]|\\.)*")\)/g),container=source.property(ROOT);for(i=0;i<wrappers.length;i++){var name=A.Codec.parse(wrappers[i].substring(9,wrappers[i].length-1));p=container.property(name);if(p.matchName===GROUP){container=p.property(CONTENTS);}}p=p.property("ADBE Vector Shape");}return p;
