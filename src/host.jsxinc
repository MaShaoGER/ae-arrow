        if (file.exists && !confirm("覆盖这个预设文件？\n" + file.fsName)) { return false; }
        file.encoding = "UTF-8";
        if (!file.open("w")) { fail("无法写入预设。请检查目录权限及 AE 的脚本文件访问设置。"); }
        try {
