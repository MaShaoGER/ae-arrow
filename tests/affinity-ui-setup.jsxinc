(function(A){
    var old=$.global.AEArrowLiveQA;if(old&&old.ui){try{old.ui.close();}catch(ignore){}}
    var c=app.project.items.addComp('AE Arrow 0.5 · Affinity 样式',1500,1000,1,3,30);c.openInViewer();
    var bg=c.layers.addSolid([.06,.075,.10],'背景',1500,1000,1);bg.locked=true;
    var styles=['箭头','有刺','V 形','圆','方框','菱形','方形尾部','三角尾部','内半圆','外半圆'],i,l,g,pg,p,s,r,a,first;
    function select(layer,prop){var j;for(j=1;j<=c.numLayers;j++){c.layer(j).selected=false;}layer.selected=true;prop.selected=true;}
    for(i=0;i<10;i++){
        var col=i%2,row=Math.floor(i/2),x=80+col*750,y=150+row*180;
        l=c.layers.addShape();l.name='源路径 · '+styles[i];l.property('ADBE Transform Group').property('ADBE Position').setValue([0,0]);
        g=l.property('ADBE Root Vectors Group').addProperty('ADBE Vector Group');g.name='钢笔';pg=g.property('ADBE Vectors Group').addProperty('ADBE Vector Shape - Group');pg.name='端点示例';p=pg.property('ADBE Vector Shape');
        s=new Shape();s.vertices=[[x,y],[x+520,y]];s.inTangents=[[0,0],[0,0]];s.outTangents=[[0,0],[0,0]];s.closed=false;p.setValue(s);select(l,p);
        r=A.LiveHost.create();a=A.LiveHost.resolve(r);a.name=styles[i];A.LiveHost.set(r,'endType',i+1);A.LiveHost.set(r,'width',12);A.LiveHost.set(r,'endWidth',112);A.LiveHost.set(r,'color',[.20,.68,1,1]);
        var text=c.layers.addText(styles[i]),tp=text.property('ADBE Text Properties').property('ADBE Text Document'),d=tp.value;d.fontSize=30;d.fillColor=[.85,.90,.98];tp.setValue(d);text.property('ADBE Transform Group').property('ADBE Position').setValue([x,y-78]);
        if(i===0){first={comp:c,target:r,owner:a,source:l,path:p,Arrow:A};}
    }
    c.saveFrameToPng(0,new File('D:/project/ae-arrow/test-results/affinity-style-gallery.png'));
    A.LiveHost.selectArrow(first.target);var ui=A.LiveUI.open(null,{show:false});
    function find(w,label){var j,v;if(w.type==='button'&&w.text===label){return w;}if(w.children){for(j=0;j<w.children.length;j++){v=find(w.children[j],label);if(v){return v;}}}return null;}
    find(ui,'读取箭头').onClick();ui.location=[2180,190];ui.show();first.ui=ui;$.global.AEArrowLiveQA=first;app.activeViewer.views[0].options.zoom=.65;
    var f=new File('D:/project/ae-arrow/test-results/affinity-ui-ready.json');f.encoding='UTF-8';f.open('w');f.write(A.Codec.stringify({ready:true,version:A.version,compId:c.id,layerId:first.owner.id}));f.close();
}(Arrow));
